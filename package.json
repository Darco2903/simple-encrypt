{
    "name": "@darco2903/simple-encrypt",
    "version": "0.4.6",
    "author": "Darco2903",
    "description": "Simple Encrypt",
    "keywords": [],
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
